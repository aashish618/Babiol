# Environment variables for Babiol

# App Configuration
NEXT_PUBLIC_APP_NAME=Babiol
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email Service (Optional - for form submissions)
# NEXT_PUBLIC_EMAIL_SERVICE=your-email-service
# EMAIL_FROM=noreply@babiol.com

# Analytics (Optional)
# NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Feature Flags
NEXT_PUBLIC_WAITLIST_ENABLED=true
NEXT_PUBLIC_DEMO_MODE=true
